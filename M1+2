# --- options.conf (правь нужные строки вручную) ---
# listen-on { 192.168.1.10; };
# listen-on-v6 { none; };
# forwarders { 8.8.8.8; };
# allow-query { any; };
# allow-recursion { any; };
vim /var/lib/bind/etc/options.conf

cat >> /var/lib/bind/etc/rfc1912.conf << 'EOF'
zone "au-team.irpo"           { type master; file "au-team.irpo"; };
zone "1.168.192.in-addr.arpa" { type master; file "1.168.192.in-addr.arpa"; };
zone "2.168.192.in-addr.arpa" { type master; file "2.168.192.in-addr.arpa"; };
zone "3.168.192.in-addr.arpa" { type master; file "3.168.192.in-addr.arpa"; };
EOF

