cp empty au-team.irpo
cp empty 1.168.192.in-addr.arpa
cp empty 2.168.192.in-addr.arpa
cp empty 3.168.192.in-addr.arpa

cat > au-team.irpo << 'EOF'
$TTL    1D
@       IN      SOA     au-team.irpo. root.au-team.irpo. (
                                2027101701
                                12H
                                1H
                                1W
                                1H )
@       IN      NS      hq-srv.au-team.irpo.
