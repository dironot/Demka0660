# Демоэкзамен 09.02.06 --- Полный гайд настройки (Модуль 1)

# ============================================
# Шаг 0. Proxmox --- настройка VLAN тегов
# ============================================
# В Proxmox для HQ-RTR на интерфейсе enp7s2 (LAN) --- НЕ ставь VLAN tag, этот адаптер будет trunk.
# На HQ-SRV → сетевой адаптер → VLAN Tag: 100
# На HQ-CLI → сетевой адаптер → VLAN Tag: 200
# Если нужна management машина в VLAN999 --- ставь Tag: 999.
# На адаптере trunk (enp7s2 HQ-RTR) поставь галку "VLAN aware" у Linux Bridge в Proxmox.


# ============================================
# Шаг 1. Имена машин (hostnamectl)
# ============================================
# ISP
hostnamectl set-hostname isp.solaredge.local; exec bash

# HQ-RTR
hostnamectl set-hostname hq-rtr.solaredge.local; exec bash

# BR-RTR
hostnamectl set-hostname br-rtr.solaredge.local; exec bash

# HQ-SRV
hostnamectl set-hostname hq-srv.solaredge.local; exec bash

# BR-SRV
hostnamectl set-hostname br-srv.solaredge.local; exec bash

# HQ-CLI
hostnamectl set-hostname hq-cli.solaredge.local; exec bash


# ============================================
# Шаг 2. IP-адресация через etcnet
# ============================================

### ISP
mkdir -p /etc/net/ifaces/enp7s1
cat > /etc/net/ifaces/enp7s1/options << 'EOF'
TYPE=eth
BOOTPROTO=dhcp
EOF

mkdir -p /etc/net/ifaces/enp7s2
cat > /etc/net/ifaces/enp7s2/options << 'EOF'
TYPE=eth
BOOTPROTO=static
EOF
echo "172.16.4.1/28" > /etc/net/ifaces/enp7s2/ipv4address

mkdir -p /etc/net/ifaces/enp7s3
cat > /etc/net/ifaces/enp7s3/options << 'EOF'
TYPE=eth
BOOTPROTO=static
EOF
echo "172.16.5.1/28" > /etc/net/ifaces/enp7s3/ipv4address

systemctl restart network

### HQ-RTR
mkdir -p /etc/net/ifaces/enp7s1
cat > /etc/net/ifaces/enp7s1/options << 'EOF'
TYPE=eth
BOOTPROTO=static
EOF
echo "172.16.4.2/28" > /etc/net/ifaces/enp7s1/ipv4address
echo "default via 172.16.4.1" > /etc/net/ifaces/enp7s1/ipv4route

mkdir -p /etc/net/ifaces/enp7s2
cat > /etc/net/ifaces/enp7s2/options << 'EOF'
TYPE=eth
BOOTPROTO=static
EOF

# VLAN100
mkdir -p /etc/net/ifaces/enp7s2.100
cat > /etc/net/ifaces/enp7s2.100/options << 'EOF'
TYPE=vlan
BOOTPROTO=static
VID=100
HOST=enp7s2
EOF
echo "192.168.100.1/28" > /etc/net/ifaces/enp7s2.100/ipv4address

# VLAN200
mkdir -p /etc/net/ifaces/enp7s2.200
cat > /etc/net/ifaces/enp7s2.200/options << 'EOF'
TYPE=vlan
BOOTPROTO=static
VID=200
HOST=enp7s2
EOF
echo "192.168.200.1/25" > /etc/net/ifaces/enp7s2.200/ipv4address

# VLAN999
mkdir -p /etc/net/ifaces/enp7s2.999
cat > /etc/net/ifaces/enp7s2.999/options << 'EOF'
TYPE=vlan
BOOTPROTO=static
VID=999
HOST=enp7s2
EOF
echo "192.168.99.1/26" > /etc/net/ifaces/enp7s2.999/ipv4address

systemctl restart network

### BR-RTR
mkdir -p /etc/net/ifaces/enp7s1
cat > /etc/net/ifaces/enp7s1/options << 'EOF'
TYPE=eth
BOOTPROTO=static
EOF
echo "172.16.5.2/28" > /etc/net/ifaces/enp7s1/ipv4address
echo "default via 172.16.5.1" > /etc/net/ifaces/enp7s1/ipv4route

mkdir -p /etc/net/ifaces/enp7s2
cat > /etc/net/ifaces/enp7s2/options << 'EOF'
